{
  "name": "@artian-techs/adonis-sms",
  "version": "1.0.0",
  "description": "Send SMS from AdonisJS using some known services",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "build/index.js",
  "type": "module",
  "files": [
    "build",
    "!build/bin",
    "!build/tests"
  ],
  "exports": {
    ".": "./build/index.js",
    "./types": "./build/src/types.js",
    "./commands": "./build/commands/main.js",
    "./services/main": "./build/services/main.js",
    "./sms_provider": "./build/providers/sms_provider.js",
    "./drivers/sns": "./build/src/drivers/sns.js",
    "./drivers/twilio": "./build/src/drivers/twilio.js",
    "./drivers/vonage": "./build/src/drivers/vonage.js",
    "./drivers/infobip": "./build/src/drivers/infobip.js",
    "./messengers/memory": "./build/src/messengers/memory_queue.js"
  },
  "keywords": [
    "sms",
    "adonisjs",
    "nodejs",
    "node.js",
    "vonage",
    "twilio",
    "sns",
    "amazon",
    "aws",
    "notification",
    "service",
    "infobip",
    "api",
    "sdk",
    "rest",
    "gateway",
    "unicode",
    "message",
    "text",
    "phone",
    "number",
    "mobile",
    "sender",
    "receiver",
    "recipient"
  ],
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles --up=1 \"stubs/**/**/*.stub\" build",
    "index:commands": "adonis-kit index build/commands",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "test": "npm run quick:test",
    "precompile": "npm run lint && npm run clean",
    "compile": "tsup-node && tsc --emitDeclarationOnly --declaration",
    "postcompile": "npm run copy:templates && npm run index:commands",
    "build": "npm run compile",
    "prepublishOnly": "npm run build",
    "version": "npm run build",
    "release": "np --message=\"chore(release): %s\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Artian-Techs/adonis-sms.git"
  },
  "author": {
    "name": "Oussama Benhamed",
    "email": "b.oussama@corposmart.dz"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Artian-Techs/adonis-sms/issues"
  },
  "homepage": "https://github.com/Artian-Techs/adonis-sms#readme",
  "dependencies": {
    "@poppinss/utils": "^6.10.1",
    "fastq": "^1.17.1"
  },
  "peerDependencies": {
    "@adonisjs/core": "^6.2.0 || ^7.0.0",
    "@aws-sdk/client-sns": "^3.540.0",
    "@infobip-api/sdk": "^0.3.0",
    "@vonage/server-sdk": "^3.15.0",
    "twilio": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-sns": {
      "optional": true
    },
    "@infobip-api/sdk": {
      "optional": true
    },
    "@vonage/server-sdk": {
      "optional": true
    },
    "twilio": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@adonisjs/core": "^6.21.0",
    "@adonisjs/eslint-config": "^2.1.2",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^1.4.1",
    "@aws-sdk/client-sns": "^3.540.0",
    "@infobip-api/sdk": "^0.3.2",
    "@japa/assert": "^3.0.0",
    "@japa/expect-type": "^2.0.2",
    "@japa/file-system": "^2.3.0",
    "@japa/runner": "^3.1.4",
    "@types/node": "^24.13.3",
    "@vonage/server-sdk": "^3.15.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^5.1.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.20.0",
    "np": "^10.0.2",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "twilio": "^5.0.0",
    "typescript": "^5.4.3"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org"
  },
  "prettier": "@adonisjs/prettier-config",
  "np": {
    "message": "chore(release): %s",
    "tag": "latest",
    "branch": "main",
    "anyBranch": false
  },
  "tsup": {
    "entry": [
      "index.ts",
      "configure.ts",
      "stubs/main.ts",
      "src/types.ts",
      "services/main.ts",
      "providers/sms_provider.ts",
      "commands/make_sms.ts",
      "src/drivers/sns.ts",
      "src/drivers/twilio.ts",
      "src/drivers/vonage.ts",
      "src/drivers/infobip.ts",
      "src/messengers/memory_queue.ts"
    ],
    "outDir": "./build",
    "clean": true,
    "format": "esm",
    "dts": false,
    "sourcemap": true,
    "target": "esnext"
  }
}
