{{{
  exports({ to: app.configPath('sms.ts') })
}}}
{{#if clients.length}}import env from '#start/env'
import { defineConfig, drivers } from '@artian-techs/adonis-sms'
{{#else}}// Uncomment both to use one of the built-in drivers
// import env from '#start/env'
// import { drivers } from '@artian-techs/adonis-sms'
import { defineConfig } from '@artian-techs/adonis-sms'
{{/if}}import type { InferSmsClients } from '@artian-techs/adonis-sms/types'

const smsConfig = defineConfig({
  {{#if clients.length}}/**
   * The client used to send messages when no client is explicitly
   * selected through "sms.use()". It is optional: without it, every call
   * must name its client, as in "sms.use('twilio')"
   */
  default: '{{ clients[0] }}',
{{#else}}/**
   * Uncomment once a client is declared below, to send through it without
   * naming it on every call
   */
  // default: 'myProvider',
{{/if}}

  /**
   * Global sender ID (phone number or alphanumeric name). Used by every
   * driver that does not define its own "from"
   */
  from: 'AdonisJS',

  /**
   * Replace consecutive whitespaces inside the message body by a single space
   */
  trim: true,

  /**
   * The clients object can be used to configure multiple clients, each one
   * using a different driver, or the same driver with a different config.
   *
   * For example: the Twilio driver can be used to define different clients
   * for transactional and promotional messages
   */
  clients: { {{#if !clients.length}}
    /**
     * No service was selected during setup. Declare your own driver here:
     *
     *   import { MyProviderDriver } from '../app/sms/drivers/my_provider.js'
     *
     *   myProvider: () => new MyProviderDriver({ apiKey: env.get('MY_API_KEY') }),
     *
     * A driver is any object implementing SmsDriverContract. See
     * https://github.com/Artian-Techs/adonis-sms#writing-a-custom-driver
     */
    {{/if}}{{#if clients.includes('twilio')}}
    twilio: drivers.twilio({
      accountSid: env.get('TWILIO_ACCOUNT_SID'),
      authToken: env.get('TWILIO_AUTH_TOKEN'),
      from: env.get('TWILIO_PHONE_NUMBER'),
    }),
    {{/if}}{{#if clients.includes('vonage')}}
    vonage: drivers.vonage({
      apiKey: env.get('VONAGE_API_KEY'),
      apiSecret: env.get('VONAGE_API_SECRET'),
    }),
    {{/if}}{{#if clients.includes('sns')}}
    sns: drivers.sns({
      key: env.get('SNS_ACCESS_KEY'),
      secret: env.get('SNS_ACCESS_SECRET'),
      region: env.get('SNS_REGION'),
      type: 'Promotional', // Or 'Transactional'
    }),
    {{/if}}{{#if clients.includes('infobip')}}
    infobip: drivers.infobip({
      baseUrl: env.get('INFOBIP_BASE_URL'),
      apiKey: env.get('INFOBIP_API_KEY'),
      authType: 'App',
    }),
    {{/if}}
  },
})

export default smsConfig

declare module '@artian-techs/adonis-sms/types' {
  export interface SmsClientsList extends InferSmsClients<typeof smsConfig> {}
}
